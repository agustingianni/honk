{
  "name": "honk",
  "version": "0.2.0",
  "description": "A terminal IRC client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agustingianni/honk.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.tsx",
    "watch": "bun --watch src/index.tsx",
    "start": "bun run src/index.tsx",
    "demo": "bun run src/index.tsx --demo",
    "typecheck": "bun check",
    "test": "bun test --parallel",
    "build": "bun scripts/build.ts",
    "release": "bun scripts/release.ts",
    "fakeircd": "bun dev/fakeircd/cli.ts",
    "fetch-themes": "bun scripts/fetch-themes.ts",
    "review-themes": "bun scripts/review-themes.tsx",
    "record-demo": "vhs scripts/demo.tape"
  },
  "dependencies": {
    "@opentui/core": "0.9.8",
    "@opentui/react": "0.9.8",
    "irc-client-ts": "0.23.1",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  },
  "patchedDependencies": {
    "irc-client-ts@0.23.1": "patches/irc-client-ts@0.23.1.patch"
  }
}
